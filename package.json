{
  "name": "dnd-adventures",
  "private": true,
  "workspaces": [
    "packages/*",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names CLIENT,SERVER --prefix-colors cyan,yellow \"yarn workspace client dev\" \"yarn workspace server dev\"",
    "build": "yarn workspace @dnd-adventures/shared-types build && yarn workspace client build && yarn workspace server build",
    "seed": "yarn tsx data/seed.ts",
    "generate-audio": "yarn tsx scripts/generate-opening-audio.ts",
    "create-dashboard": "yarn tsx --env-file=.env scripts/create-dashboard/index.ts",
    "prewarm:phrases": "yarn tsx --env-file=.env scripts/prewarm-phrases.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
